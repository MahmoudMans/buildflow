# Public BuildFlow URL.
# Replace both example.com values before deployment.

BUILDFLOW_SITE_ADDRESS=https://buildflow.example.com
BUILDFLOW_PUBLIC_URL=https://buildflow.example.com

HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL.

POSTGRES_DB=buildflow
POSTGRES_USER=buildflow
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

# MinIO.

MINIO_ACCESS_KEY=CHANGE_ME_WITH_A_RANDOM_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_MINIO_SECRET_KEY
MINIO_BUCKET=buildflow

# SMTP.
#
# For a real production environment, replace these with your
# SMTP server. If left as mailpit/1025, email remains local
# inside the deployment and is not externally delivered.

SMTP_HOST=mailpit
SMTP_PORT=1025

# Browser/session security.

BUILDFLOW_SESSION_COOKIE_SECURE=true

# Public portfolio demo.
#
# Keep false for a normal production tenant environment.
# Enable only on an isolated portfolio/demo deployment.

BUILDFLOW_DEMO_ENABLED=false

# The portfolio frontend currently documents this demo password.
# It is relevant only when BUILDFLOW_DEMO_ENABLED=true.

BUILDFLOW_DEMO_PASSWORD=BuildFlowDemo2026!
